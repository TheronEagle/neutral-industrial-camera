# Frontend build-time variables (baked into JS, must NEVER hold secrets)
# Set true ONLY to run the app locally against demo data.
VITE_USE_MOCK_AI=false

# --- Server-side only. Configure in Cloudflare, never commit. ---
# Gateway root or root/v1. NOT a secret, but keep it server-side.
FREELLMAPI_GATEWAY_URL=
# Vision model id from GET {GATEWAY}/v1/models. Left blank on purpose:
# it must be chosen from the real roster, not guessed.
FREELLMAPI_VISION_MODEL=
# Only if your gateway requires auth. Set with:
#   npx wrangler secret put FREELLMAPI_API_KEY
FREELLMAPI_API_KEY=
