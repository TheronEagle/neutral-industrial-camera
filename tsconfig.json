{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@aesthetic": ["src/aesthetic"],
      "@aesthetic/*": ["src/aesthetic/*"],
      "@camera": ["src/camera"],
      "@camera/*": ["src/camera/*"],
      "@ai": ["src/ai"],
      "@ai/*": ["src/ai/*"],
      "@gallery": ["src/gallery"],
      "@gallery/*": ["src/gallery/*"],
      "@editor": ["src/editor"],
      "@editor/*": ["src/editor/*"],
      "@hooks": ["src/hooks"],
      "@hooks/*": ["src/hooks/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@storage": ["src/storage"],
      "@storage/*": ["src/storage/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "workers"]
}
