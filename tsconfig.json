{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@": ["src"],
      "@aesthetic": ["src/aesthetic"],
      "@camera": ["src/camera"],
      "@ai": ["src/ai"],
      "@gallery": ["src/gallery"],
      "@editor": ["src/editor"],
      "@hooks": ["src/hooks"],
      "@services": ["src/services"],
      "@storage": ["src/storage"],
      "@utils": ["src/utils"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
